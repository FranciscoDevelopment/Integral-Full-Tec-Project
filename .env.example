# Postgres. Evitá @ / # ? : en la contraseña: va dentro de DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_PORT=5432

# API
API_PORT=4000
# The two JWT secrets must be different (generate each one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=3h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Session cookies: true only when the API is served over HTTPS
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
# Reverse proxies in front of the API (0 locally; 1 behind Render, Railway or Nginx). The rate limit needs it
TRUST_PROXY=0
