{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "<rootDir>/esm-to-cjs.transformer.js"
  },
  "transformIgnorePatterns": ["/node_modules/\\.pnpm/(?!@nestjs\\+passport@)"],
  "maxWorkers": 1
}
