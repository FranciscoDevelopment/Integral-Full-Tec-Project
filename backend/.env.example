# Used when the API or Prisma run on your machine (outside Docker).
# Same credentials as the root .env, but host 127.0.0.1 (not "localhost": on Windows
# Node resolves it to IPv6 and Docker only publishes the IPv4 port) and port = DB_PORT.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB_NAME?schema=public
PORT=4000
FRONTEND_URL=http://localhost:3000

# The two JWT secrets must be different. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=3h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Session cookies: set to true when the API is served over HTTPS. It also makes them SameSite=None,
# which is what lets a front and an API on different domains (Vercel + Render) share the session
COOKIE_SECURE=false

# How many reverse proxies sit in front of the API (Render, Railway, Nginx: 1). 0 = none, as locally.
# Needed for the rate limit: behind a proxy it would see every user as the same IP
TRUST_PROXY=0

# Only read by the seed (pnpm seed). Optional locally: the demo password is used.
# Required to seed a production database
SEED_ADMIN_PASSWORD=
